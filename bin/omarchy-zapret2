WANTED = re.compile(r"^(binaries/linux-x86_64/(nfqws2|mdig|ip2net)|lua/[a-z0-9-]+\.lua|files/fake/[A-Za-z0-9_.-]+\.bin"
                    r"|blockcheck2\.sh|blockcheck2\.d/[A-Za-z0-9_./-]+|common/[a-z0-9_]+\.sh|config\.default)$")


def install_engine(tarball, sha, version):
    if not RE_VERSION.match(version) or not RE_SHA.match(sha):
        raise Fail("bad version or checksum")
    fd = os.open(tarball, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    with os.fdopen(fd, "rb") as f:
        data = f.read(MAX_TARBALL + 1)
    if len(data) > MAX_TARBALL or hashlib.sha256(data).hexdigest() != sha:
        raise Fail("the archive does not match its checksum")
    os.makedirs(SYS_ENGINE, mode=0o755, exist_ok=True)
    tmp = tempfile.mkdtemp(dir=SYS_ENGINE, prefix=".new-")
    try:
        raw = os.path.join(tmp, "raw")
        with tarfile.open(fileobj=io.BytesIO(data), mode="r:gz") as tf:
            members = []
            prefix = "zapret2-%s/" % version
            for m in tf.getmembers():
                if not m.name.startswith(prefix):
                    continue
                rel = m.name[len(prefix):]
                if (m.isfile() and WANTED.match(rel)) or (m.isdir() and rel):
                    m.name = rel
                    members.append(m)
            tf.extractall(raw, members=members, filter="data")
        dest = os.path.join(tmp, "engine")
        os.makedirs(dest)
        for bin_name in ("nfqws2", "mdig", "ip2net"):
            src = os.path.join(raw, "binaries/linux-x86_64", bin_name)
            sub = "nfq2" if bin_name == "nfqws2" else bin_name
            os.makedirs(os.path.join(dest, sub))
            shutil.copyfile(src, os.path.join(dest, sub, bin_name))
            os.chmod(os.path.join(dest, sub, bin_name), 0o755)
        for item in ("lua", "files", "blockcheck2.d", "common"):
            shutil.copytree(os.path.join(raw, item), os.path.join(dest, item))
        for item in ("blockcheck2.sh", "config.default"):
            shutil.copyfile(os.path.join(raw, item), os.path.join(dest, item))
        os.chmod(os.path.join(dest, "blockcheck2.sh"), 0o755)
        for f in os.listdir(os.path.join(DATA, "fake")):
            shutil.copyfile(os.path.join(DATA, "fake", f), os.path.join(dest, "files", "fake", f))
        r = sh(os.path.join(dest, "nfq2", "nfqws2"), "--version", timeout=10)
        if r.returncode != 0 or version not in r.stdout:
            raise Fail("the new nfqws2 does not run: %s" % (r.stdout + r.stderr).strip()[:200])
        normalize_tree(dest)
        final = os.path.join(SYS_ENGINE, version)
        if os.path.lexists(final):
            shutil.rmtree(final)
        os.rename(dest, final)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    link_tmp = os.path.join(SYS_ENGINE, ".current")
    if os.path.lexists(link_tmp):
        os.unlink(link_tmp)
    prev = os.path.basename(os.path.realpath(os.path.join(SYS_ENGINE, "current"))) if os.path.islink(os.path.join(SYS_ENGINE, "current")) else None
    os.symlink(version, link_tmp)
    os.replace(link_tmp, os.path.join(SYS_ENGINE, "current"))
    for d in os.listdir(SYS_ENGINE):                 # keep the new and the previous version
        if d not in (version, prev, "current") and RE_VERSION.match(d):
            shutil.rmtree(os.path.join(SYS_ENGINE, d), ignore_errors=True)


def normalize_tree(root):
    for d, dirs, files in os.walk(root):
        os.chown(d, 0, 0)
        os.chmod(d, 0o755)
        for f in files:
            p = os.path.join(d, f)
            os.chown(p, 0, 0, follow_symlinks=False)
            if not os.path.islink(p):
                os.chmod(p, 0o755 if os.access(p, os.X_OK) or f.endswith(".sh") else 0o644)


def install_app():
    """Copy this script and data/ to the root-owned app folder the units run."""
    tmp = tempfile.mkdtemp(dir=SYS_BASE, prefix=".app-")
    try:
        os.makedirs(os.path.join(tmp, "bin"))
        shutil.copyfile(SELF, os.path.join(tmp, "bin", "omarchy-zapret2"))
        shutil.copytree(DATA, os.path.join(tmp, "data"), symlinks=False)
        normalize_tree(tmp)
        os.chmod(os.path.join(tmp, "bin", "omarchy-zapret2"), 0o755)
        old = SYS_APP + ".old"
        shutil.rmtree(old, ignore_errors=True)
        if os.path.exists(SYS_APP):
            os.rename(SYS_APP, old)
        os.rename(tmp, SYS_APP)
        shutil.rmtree(old, ignore_errors=True)
    except BaseException:
        shutil.rmtree(tmp, ignore_errors=True)
        raise


def ensure_var(uid, gid):
    for d in (VAR, os.path.join(VAR, "lists"), os.path.join(VAR, "lists", "upstream"), os.path.join(VAR, "custom"),
              os.path.join(VAR, "flowseal")):
        try:
            st = os.lstat(d)
        except FileNotFoundError:
            os.mkdir(d, 0o755)
            os.chown(d, uid, gid)
            continue
        if not (st.st_mode & 0o170000 == 0o040000) or st.st_uid != uid:
            raise Fail("%s exists and is not this user's folder" % d)
    os.chmod(VAR, 0o755)


def cmd_install(args):
    require_root()
    uid = caller_uid()
    pw = pwd.getpwuid(uid)
    rec = load_record()
    if rec and rec.get("uid") != uid:
        raise Fail("zapret2 is set up for another user (uid %s)" % rec.get("uid"))
    opts = dict(zip(args[::2], args[1::2]))
    version = rec.get("version") if rec else None
    os.makedirs(SYS_BASE, mode=0o755, exist_ok=True)
    os.chmod(SYS_BASE, 0o755)
    if "--tarball" in opts:
        install_engine(opts["--tarball"], opts.get("--sha256", ""), opts.get("--version", ""))
        version = opts["--version"]
    if not version:
        raise Fail("no engine installed yet")
    install_app()
    ensure_var(uid, pw.pw_gid)
    files = {
        os.path.join(UNIT_DIR, UNIT): UNIT_TEXT.format(app=SYS_APP),
        os.path.join(UNIT_DIR, BC_UNIT): BC_UNIT_TEXT.format(app=SYS_APP),
        POLKIT_RULE: POLKIT_TEXT % {"user": pw.pw_name, "unit": UNIT, "bc": BC_UNIT},
    }
    for path, text in files.items():
        if os.path.islink(path):
            raise Fail("%s is a symlink: refusing" % path)
        atomic_write(path, text, mode=0o644)
    hashed = dict((p, hashlib.sha256(t.encode()).hexdigest()) for p, t in files.items())
    hashed[SYS_APP + "/bin/omarchy-zapret2"] = sha256_file(SYS_APP + "/bin/omarchy-zapret2")
    hashed[SYS_ENGINE + "/current/nfq2/nfqws2"] = sha256_file(SYS_ENGINE + "/current/nfq2/nfqws2")
    atomic_write(RECORD, json.dumps({"uid": uid, "user": pw.pw_name, "version": version, "files": hashed,
                                     "time": int(time.time())}, indent=1) + "\n", mode=0o644)
    sh("systemctl", "daemon-reload", timeout=60)
    if unit_state(UNIT).get("ActiveState") == "active":
        sh("systemctl", "restart", UNIT, timeout=60)
    out({"ok": True, "version": version})


def cmd_uninstall(args):
    require_root()
    uid = caller_uid()
    rec = load_record()
    if rec and rec.get("uid") != uid:
        raise Fail("zapret2 is set up for another user")
    for u in (BC_UNIT, UNIT):
        sh("systemctl", "stop", u, timeout=60)
    sh("nft", "delete", "table", "inet", NFT_TABLE, timeout=10)
    removed = []
    for path in (os.path.join(UNIT_DIR, UNIT), os.path.join(UNIT_DIR, BC_UNIT), POLKIT_RULE):
        if os.path.lexists(path):
            os.unlink(path)
            removed.append(path)
    shutil.rmtree(SYS_BASE, ignore_errors=True)
    shutil.rmtree(RUN_BC, ignore_errors=True)
    removed.append(SYS_BASE)
    try:
        if not os.path.islink(HOSTS_FILE):
            text = read_nofollow(HOSTS_FILE, MAX_LIST)
            if text is not None and HOSTS_BEGIN in text:
                atomic_write(HOSTS_FILE, apply_hosts_block(text, None), mode=0o644)
                removed.append(HOSTS_FILE + " block")
    except (Fail, OSError):
        pass
    if "--purge" in args and os.path.isdir(VAR) and not os.path.islink(VAR) and os.lstat(VAR).st_uid == uid:
        shutil.rmtree(VAR)
        removed.append(VAR)
    sh("systemctl", "daemon-reload", timeout=60)
    out({"ok": True, "removed": removed})


def prepare_lists(uid):
    """Validated copies of every list in RUN: nfqws2 never reads the user's files."""
    lists = os.path.join(RUN, "lists")
    os.makedirs(lists, mode=0o755, exist_ok=True)
    counts = {}
    for name in BASE_LISTS + USER_LISTS:
        text = None
        if name in BASE_LISTS:
            try:
                text = read_nofollow(os.path.join(VAR, "lists", "upstream", name + ".txt"), MAX_LIST, owner=uid)
            except Fail:
                text = None
            if not text:
                with open(os.path.join(DATA, "lists", name + ".txt"), encoding="utf-8") as f:
                    text = f.read()
        else:
            try:
                text = read_nofollow(os.path.join(VAR, "lists", name + ".txt"), MAX_LIST, owner=uid) or ""
            except Fail:
                text = ""
        lines = clean_list(text, list_kind(name))
        counts[name] = len(lines)
        atomic_write(os.path.join(lists, name + ".txt"), "\n".join(lines) + "\n" if lines else "")
    # an ipset that matches nothing (TEST-NET-3), for ipset=none and an empty loaded set
    atomic_write(os.path.join(lists, "ipset-none.txt"), "203.0.113.113/32\n")
    return lists, counts


def load_preset_for_run(name, uid):
    if name.startswith("fs-"):
        text = read_nofollow(os.path.join(VAR, "flowseal", name + ".txt"), MAX_SMALL * 4, owner=uid)
        if text is None:
            try:
                with open(os.path.join(DATA, "presets", "flowseal", name + ".txt"), encoding="utf-8") as f:
                    text = f.read()
            except OSError:
                raise Fail("no such strategy: %s" % name)
        return parse_full(text)
    if name in PRESETS:
        with open(os.path.join(DATA, "presets", name + ".txt"), encoding="utf-8") as f:
            return parse_preset(f.read())
    text = read_nofollow(os.path.join(VAR, "custom", name + ".txt"), MAX_SMALL, owner=uid)
    if text is None:
        raise Fail("custom strategy %s is gone" % name)
    if is_full_preset_text(text):
        return parse_full(text)
    return parse_preset(text)


def cmd_run():
    require_root(from_system=True)
    rec = load_record()
    if not rec:
        raise Fail("not set up")
    uid = int(rec["uid"])
    try:
        settings = clean_settings(json.loads(read_nofollow(os.path.join(VAR, "settings.json"), MAX_SMALL, owner=uid) or "{}"))
    except ValueError:
        settings = dict(DEFAULTS)
    try:
        sections = load_preset_for_run(settings["preset"], uid)
    except Fail as e:
        print("omarchy-zapret2: %s; falling back to %s" % (e, DEFAULTS["preset"]), file=sys.stderr)
        settings["preset"] = DEFAULTS["preset"]
        sections = load_preset_for_run(DEFAULTS["preset"], uid)
    engine = os.path.realpath(os.path.join(SYS_ENGINE, "current"))
    if not engine.startswith(SYS_ENGINE + "/"):
        raise Fail("engine link points outside %s" % SYS_ENGINE)
    lists, counts = prepare_lists(uid)
    if "full" in sections:
        args = ["--qnum=%d" % QNUM, "--user=nobody", "--fwmark=0x%x" % MARK, "--ctrack-disable=0",
                "--ipcache-lifetime=8400", "--ipcache-hostname=1",
                "--lua-init=@%s/lua/zapret-lib.lua" % engine, "--lua-init=@%s/lua/zapret-antidpi.lua" % engine]
        args += ["--blob=%s:@%s" % (name, os.path.join(engine, "files", "fake", f))
                 for name, f in sorted(BLOB_FILES.items())]
        full_args, (tcp, udp) = render_full(sections["full"], settings, engine, lists, counts)
        args = drop_empty_user_lists(args + full_args, lists, counts)
    else:
        args = render_args(settings["preset"], sections, settings, engine, lists,
                           [os.path.join(engine, "files", "fake")], counts)
        tcp, udp = ports_for(settings, sections)
    conf = os.path.join(RUN, "nfqws2.conf")
    atomic_write(conf, "\n".join(args) + "\n")
    rules = os.path.join(RUN, "rules.nft")
    atomic_write(rules, render_nft(tcp, udp, settings["ipv6"]))
    r = sh(tool("nft") or "nft", "-f", rules, timeout=20, env={"PATH": "/usr/bin:/bin"})
    if r.returncode != 0:
        raise Fail("nft: %s" % r.stderr.strip()[:400])
    print("omarchy-zapret2: strategy %s, game %s, ipset %s, voice %s, tcp %s, udp %s"
          % (settings["preset"], settings["game"], settings["ipset"], settings["voice"], ",".join(tcp), ",".join(udp)),
          file=sys.stderr, flush=True)
    nfqws = os.path.join(engine, "nfq2", "nfqws2")
    os.execve(nfqws, [nfqws, "@" + conf], {"PATH": "/usr/bin:/bin"})


def cmd_stop():
    require_root(from_system=True)
    sh(tool("nft") or "nft", "delete", "table", "inet", NFT_TABLE, timeout=10, env={"PATH": "/usr/bin:/bin"})
    out({"ok": True})


def cmd_blockcheck_run():
    require_root(from_system=True)
    rec = load_record()
    uid = int(rec["uid"])
    req = json.loads(read_nofollow(os.path.join(VAR, "blockcheck.json"), MAX_SMALL, owner=uid) or "{}")
    domains = [d for d in req.get("domains", []) if isinstance(d, str) and RE_DOMAIN.match(d)][:8] or ["youtube.com"]
    level = req.get("level") if req.get("level") in ("quick", "standard", "force") else "quick"
    engine = os.path.realpath(os.path.join(SYS_ENGINE, "current"))
    os.makedirs(RUN_BC, mode=0o755, exist_ok=True)
    env = {"PATH": "/usr/bin:/bin:/usr/sbin:/sbin", "BATCH": "1", "DOMAINS": " ".join(domains),
           "IPVS": "46" if req.get("ipv6") is True else "4", "SCANLEVEL": level, "REPEATS": "1",
           "ENABLE_HTTP": "1", "ENABLE_HTTPS_TLS12": "1", "ENABLE_HTTPS_TLS13": "1", "ENABLE_HTTP3": "1",
           "ZAPRET_BASE": engine, "ZAPRET_RW": RUN_BC, "ZAPRET_CONFIG": os.path.join(RUN_BC, "config"),
           "SKIP_DNSCHECK": "1", "LANG": "C"}
    log = os.path.join(RUN_BC, "blockcheck.log")
    with open(log, "w", encoding="utf-8") as f:
        os.fchmod(f.fileno(), 0o644)
        f.write("# omarchy-zapret2 blockcheck2: %s, level %s\n" % (" ".join(domains), level))
        f.flush()
        p = subprocess.run(["/bin/sh", os.path.join(engine, "blockcheck2.sh")], stdout=f, stderr=subprocess.STDOUT,
                           stdin=subprocess.DEVNULL, env=env, cwd=RUN_BC)
    sys.exit(p.returncode)


def cmd_blockcheck_done():
    """ExecStopPost of the blockcheck unit: restart the bypass if it was on."""
    require_root(from_system=True)
    rec = load_record()
    try:
        req = json.loads(read_nofollow(os.path.join(VAR, "blockcheck.json"), MAX_SMALL, owner=int(rec["uid"])) or "{}")
    except (Fail, ValueError, TypeError, KeyError):
        req = {}
    if req.get("resume") is True:
        sh("systemctl", "start", "--no-block", UNIT, timeout=30, env={"PATH": "/usr/bin:/bin"})
    out({"ok": True, "resumed": req.get("resume") is True})


# --------------------------------------------------------------- main

def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    cmd, args = argv[0], argv[1:]
    if os.geteuid() == 0 and not cmd.startswith("_"):
        raise Fail("run as your user, not root")
    def need(n, usage):
        if len(args) < n:
            raise Fail("usage: " + usage)

    if cmd == "status":
        cmd_status()
    elif cmd == "presets" and args[:1] == ["update"]:
        cmd_presets_update()
    elif cmd == "presets" and args[:1] == ["show"]:
        cmd_presets_show(args[1:])
    elif cmd == "presets":
        cmd_presets()
    elif cmd in ("on", "off", "restart"):
        {"on": cmd_on, "off": cmd_off, "restart": cmd_restart}[cmd]()
    elif cmd == "set":
        need(2, "set <key> <value>")
        cmd_set(args[0], args[1])
    elif cmd == "custom":
        cmd_custom(args)
    elif cmd == "strategy":
        cmd_strategy(args)
    elif cmd == "list":
        cmd_list(args)
    elif cmd == "lists" and args[:1] == ["update"]:
        cmd_lists_update()
    elif cmd == "export":
        cmd_export(args)
    elif cmd == "import":
        cmd_import(args)
    elif cmd == "services":
        cmd_services()
    elif cmd == "service":
        cmd_service(args)
    elif cmd == "hosts":
        cmd_hosts(args)
    elif cmd == "dns":
        cmd_dns(args)
    elif cmd == "discord-cache":
        cmd_discord_cache(args)
    elif cmd == "check":
        cmd_check(args)
    elif cmd == "autopick":
        cmd_autopick(args)
    elif cmd == "circular":
        cmd_circular(args)
    elif cmd == "blockcheck":
        cmd_blockcheck(args)
    elif cmd == "setup":
        cmd_setup(args)
    elif cmd == "engine" and args[:1] == ["check"]:
        cmd_engine_check()
    elif cmd == "engine" and args[:1] == ["update"]:
        cmd_setup(args[1:])
    elif cmd == "updates" and args[:1] == ["check"]:
        cmd_updates_check()
    elif cmd == "remove":
        cmd_remove(args)
    elif cmd == "first-run":
        cmd_first_run()
    elif cmd == "diagnostics":
        cmd_diagnostics()
    elif cmd == "doctor":
        cmd_doctor()
    elif cmd == "logs":
        cmd_logs(args)
    elif cmd == "desktop":
        desktop(args[:1] != ["off"])
        out({"ok": True})
    elif cmd == "_install":
        cmd_install(args)
    elif cmd == "_uninstall":
        cmd_uninstall(args)
    elif cmd == "_run":
        cmd_run()
    elif cmd == "_stop":
        cmd_stop()
    elif cmd == "_blockcheck":
        cmd_blockcheck_run()
    elif cmd == "_blockcheck-done":
        cmd_blockcheck_done()
    elif cmd == "_hosts":
        cmd_hosts_root(args)
    else:
        raise Fail("unknown command: %s (see --help)" % " ".join(argv[:2]))
    return 0


if __name__ == "__main__":
    os.umask(0o022)
    try:
        sys.exit(main(sys.argv[1:]))
    except Fail as e:
        out({"ok": False, "error": str(e)})
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
