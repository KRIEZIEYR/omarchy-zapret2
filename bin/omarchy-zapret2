# ipset "none" like Flowseal's shipped default: the strategy touches only
# hostlist domains; "loaded" applies it to ~33k networks and can break sites
# that are not blocked at all.
DEFAULTS = {"preset": "fs-general", "game": "off", "ipset": "none", "voice": "compatible",
            "ipv6": True, "autostart": False, "gameTcp": "1024-65535", "gameUdp": "1024-65535",
            "discordFake": "default", "gameFake": "default"}
ENUMS = {"game": ("off", "tcp", "udp", "all"), "ipset": ("loaded", "none", "any"),
         "voice": ("compatible", "standard", "off")}
GAME_PORT_DEFAULT = "1024-65535"
GAME_PORT_MAX_ITEMS = 16

HOSTS_URL = "https://raw.githubusercontent.com/Flowseal/zapret-discord-youtube/main/.service/hosts"
HOSTS_BEGIN = "# >>> omarchy-zapret2 (Flowseal hosts) >>>"
HOSTS_END = "# <<< omarchy-zapret2 <<<"
HOSTS_FILE = "/etc/hosts"
MAX_HOSTS = 256 * 1024

# Lists: bundled defaults (data/lists, may be replaced by `lists update`) and
# the user's own additions, edited from the app.
BASE_LISTS = ("list-general", "list-google", "list-exclude", "list-discord-web", "ipset-all", "ipset-exclude")
USER_LISTS = ("list-general-user", "list-exclude-user", "ipset-all-user", "ipset-exclude-user")

PRESETS = {
    "general": "fake + multisplit, the usual first try",
    "alt": "fake + fakedsplit",
    "alt3": "hostfakesplit",
    "alt5": "syndata + multidisorder",
    "alt11": "multistage multisplit",
    "alt12": "large seqovl, Google via hostfakesplit",
    "fake-tls-auto": "fake with auto TTL + multidisorder",
    "fake-tls-auto-alt2": "fake with auto TTL + multisplit",
    "simple-fake": "fake only",
    "voice": "tuned for Discord voice",
    "custom-safe": "experimental, low intervention",
    "custom-balanced": "experimental, daily candidate",
    "custom-aggressive": "experimental, for hard DPI",
}

SECTIONS = ("TCP_HTTP", "TCP_TLS", "TCP_GENERIC", "QUIC", "GOOGLE_TLS", "DISCORD_MEDIA_TLS",
            "DISCORD_WEB_TLS", "IPSET_TCP_PORTS", "VOICE_COMPATIBLE")
REQUIRED = ("TCP_HTTP", "TCP_TLS", "TCP_GENERIC", "QUIC")

# Desync functions a strategy may call: zapret-antidpi.lua only. Never the
# helpers in zapret-lib/zapret-auto (luaexec runs Lua source; condition and
# friends call other functions by name).
LUA_FUNCS = frozenset((
    "drop send pktmod http_domcase http_hostcase http_methodeol http_unixeol synack_split synack "
    "wsize wssize tls_client_hello_clone syndata rst fake multisplit multidisorder multidisorder_legacy "
    "hostfakesplit fakedsplit fakeddisorder tcpseg oob udplen dht_dn").split())
PAYLOADS = frozenset((
    "all unknown empty known ipv4 ipv6 icmp http_req http_reply tls_client_hello tls_server_hello "
    "dtls_client_hello dtls_server_hello quic_initial wireguard_initiation wireguard_response "
    "wireguard_cookie wireguard_keepalive wireguard_data dht discord_ip_discovery stun xmpp_stream "
    "xmpp_starttls xmpp_proceed xmpp_features dns_query dns_response mtproto_initial bt_handshake "
    "utp_bt_handshake").split())
L7 = frozenset("all unknown known http tls dtls quic wireguard dht discord stun xmpp dns mtproto bt utp_bt".split())
# name -> file in the engine's files/fake (the extra four ship in data/fake)
BLOB_FILES = {
    "tls_google": "tls_clienthello_www_google_com.bin",
    "tls_max": "tls_clienthello_max_ru.bin",
    "quic_google": "quic_initial_www_google_com.bin",
    "stun": "stun.bin",
    "http_iana": "http_iana_org.bin",
    "zero": "zero_512.bin",
    "discord_voice": "quic_initial_dbankcloud_ru.bin",
    "game_udp": "quic_initial_dbankcloud_ru.bin",
}
# Flowseal's fakes, bundled in data/fake-flowseal: fs_<file stem>
FS_FAKES = os.path.join(DATA, "fake-flowseal")
try:
    FS_BLOB_FILES = {"fs_" + f[:-4].lower(): f for f in sorted(os.listdir(FS_FAKES)) if f.endswith(".bin")}
except OSError:
    FS_BLOB_FILES = {}
FS_CLONE = "fs_orig"          # tls_client_hello_clone target: the original ClientHello
BLOBS = (frozenset(BLOB_FILES) | frozenset(FS_BLOB_FILES)
         | {"fake_default_tls", "fake_default_http", "fake_default_quic", FS_CLONE})
BLOB_KEYS = ("blob", "pattern", "seqovl_pattern")
# parameters that name a Lua function: `fool` always, `ipfrag` unless the built-in fragmenter
FUNC_KEYS = {"fool": (), "ipfrag": ("", "ipfrag2")}

RE_TOKEN = re.compile(r"^[A-Za-z0-9_.,+=\-]{0,200}$")
RE_KEY = re.compile(r"^[a-z][a-z0-9_]{0,31}$")
RE_RANGE = re.compile(r"^[nadspbx]?\d{0,9}-[nadspbx]?\d{0,9}$|^[ax]$")  # no "<": wordexp in @config
RE_PORTS = re.compile(r"^\d{1,5}(-\d{1,5})?(,\d{1,5}(-\d{1,5})?)*$")
RE_HEX = re.compile(r"^0x[0-9A-Fa-f]{2,512}$")
RE_NAME = re.compile(r"^[a-z0-9][a-z0-9-]{0,31}$")
RE_DOMAIN = re.compile(r"^(?=.{1,253}$)([a-z0-9_]([a-z0-9_-]{0,61}[a-z0-9_])?\.)*[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$")
RE_VERSION = re.compile(r"^v\d{1,4}(\.\d{1,4}){1,4}$")
RE_SHA = re.compile(r"^[0-9a-f]{64}$")


# --------------------------------------------------------------- plumbing

class Fail(Exception):
    pass


def out(obj):
    sys.stdout.write(json.dumps(obj, ensure_ascii=False) + "\n")
    sys.stdout.flush()


def progress(**kw):
    out(dict(kw, progress=True))


def child_env():
    keep = ("PATH", "HOME", "USER", "LOGNAME", "LANG", "XDG_RUNTIME_DIR", "DBUS_SESSION_BUS_ADDRESS",
            "WAYLAND_DISPLAY", "DISPLAY")
    env = {k: os.environ[k] for k in keep if k in os.environ}
    env.setdefault("PATH", "/usr/bin:/bin")
    return env


def tool(name):
    for d in ("/usr/bin", "/bin", "/usr/sbin", "/sbin"):
        p = os.path.join(d, name)
        if os.access(p, os.X_OK):
            return p
    return None


def sh(*args, timeout=60, env=None, input=None):
    try:
        return subprocess.run(list(args), capture_output=True, text=True, timeout=timeout,
                              env=env if env is not None else child_env(), input=input)
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(list(args), 124, "", "timed out")
    except OSError as e:
        return subprocess.CompletedProcess(list(args), 127, "", str(e))


def read_nofollow(path, cap, owner=None):
    """A small regular file, never through a symlink; None when absent.
    owner: the uid the file must belong to (files the root side reads from VAR)."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    except FileNotFoundError:
        return None
    except OSError:
        raise Fail("%s is not a regular file" % path)
    with os.fdopen(fd, "rb") as f:
        st = os.fstat(f.fileno())
        if not (st.st_mode & 0o170000 == 0o100000):
            raise Fail("%s is not a regular file" % path)
        if owner is not None and st.st_uid != owner:
            raise Fail("%s has a foreign owner" % path)
        data = f.read(cap + 1)
    if len(data) > cap:
        raise Fail("%s is larger than %d bytes" % (path, cap))
    return data.decode("utf-8", "replace")


def atomic_write(path, data, mode=0o644):
    d = os.path.dirname(path)
    os.makedirs(d, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=d, prefix="." + os.path.basename(path) + ".")
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, "wb") as f:
            f.write(data.encode("utf-8") if isinstance(data, str) else data)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def load_record():
    try:
        text = read_nofollow(RECORD, MAX_SMALL)
        return json.loads(text) if text else None
    except (Fail, ValueError):
        return None


# --------------------------------------------------------------- validation

def clean_settings(raw):
    """Settings from VAR are untrusted: unknown keys dropped, bad values defaulted."""
    s = dict(DEFAULTS)
    if not isinstance(raw, dict):
        return s
    p = raw.get("preset")
    if isinstance(p, str) and (p in PRESETS or (p.startswith(("my-", "fs-")) and RE_NAME.match(p))):
        s["preset"] = p
    for k, allowed in ENUMS.items():
        if raw.get(k) in allowed:
            s[k] = raw[k]
    for k in ("ipv6", "autostart"):
        if isinstance(raw.get(k), bool):
            s[k] = raw[k]
    for k in ("gameTcp", "gameUdp"):
        v = raw.get(k)
        if isinstance(v, str) and valid_game_ports(v):
            s[k] = v
    for k in ("discordFake", "gameFake"):
        v = raw.get(k)
        if v == "default" or (isinstance(v, str) and v in fake_choices()):
            s[k] = v
    return s


def valid_game_ports(text):
    """check_ports-style validation for custom game filters: comma list of
    ports/ranges 1-65535, at most GAME_PORT_MAX_ITEMS items."""
    if not isinstance(text, str) or not RE_PORTS.match(text):
        return False
    parts = text.split(",")
    if not parts or len(parts) > GAME_PORT_MAX_ITEMS:
        return False
    try:
        for part in parts:
            a, _, b = part.partition("-")
            if not (1 <= int(a) <= 65535 and (not b or int(a) <= int(b) <= 65535)):
                return False
    except ValueError:
        return False
    return True


def fake_choices():
    """Allowed discordFake/gameFake values besides 'default': fs_quic_* and fs_stun* blobs."""
    return sorted(n for n in FS_BLOB_FILES if n.startswith("fs_quic_") or n.startswith("fs_stun"))


def game_filter(settings, which):
    """Custom game filter for one direction; '12' is the disabled sentinel."""
    key = "gameTcp" if which == "tcp" else "gameUdp"
    custom = settings.get(key, GAME_PORT_DEFAULT)
    if not valid_game_ports(custom):
        custom = GAME_PORT_DEFAULT
    modes = ("tcp", "all") if which == "tcp" else ("udp", "all")
    return custom if settings.get("game") in modes else "12"


def check_ports(text):
    if not RE_PORTS.match(text):
        raise Fail("bad port list: %s" % text)
    for part in text.split(","):
        a, _, b = part.partition("-")
        if not (1 <= int(a) <= 65535 and (not b or int(a) <= int(b) <= 65535)):
            raise Fail("bad port range: %s" % part)


def check_desync(spec):
    parts = spec.split(":")
    if parts[0] not in LUA_FUNCS:
        raise Fail("desync function not allowed: %s" % parts[0])
    for p in parts[1:]:
        k, eq, v = p.partition("=")
        if not RE_KEY.match(k) or not RE_TOKEN.match(v):
            raise Fail("bad desync parameter: %s" % p)
        if eq and k in BLOB_KEYS and v not in BLOBS and not RE_HEX.match(v):
            raise Fail("unknown blob: %s" % v)
        if k in FUNC_KEYS and v not in FUNC_KEYS[k]:
            raise Fail("parameter not allowed: %s" % k)


def check_line(line, section):
    """One strategy line. Only options that change how packets are desynced;
    nothing that loads files, Lua code or changes what is intercepted."""
    opt, eq, val = line.partition("=")
    if not eq:
        raise Fail("not an option: %s" % line)
    if opt == "--lua-desync":
        check_desync(val)
    elif opt == "--payload":
        bad = [v for v in val.split(",") if v not in PAYLOADS]
        if bad:
            raise Fail("unknown payload type: %s" % ",".join(bad))
    elif opt in ("--out-range", "--in-range"):
        if not RE_RANGE.match(val):
            raise Fail("bad range: %s" % val)
    elif section == "VOICE_COMPATIBLE" and opt == "--filter-udp":
        check_ports(val)
    elif section == "VOICE_COMPATIBLE" and opt == "--filter-l7":
        bad = [v for v in val.split(",") if v not in L7]
        if bad:
            raise Fail("unknown protocol: %s" % ",".join(bad))
    else:
        raise Fail("option not allowed in a strategy: %s" % opt)


def parse_preset(text, validate=True):
    """[SECTION] blocks of nfqws2 options, one per line; '#' comments."""
    sections, cur = {}, None
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        m = re.match(r"^\[([A-Z_]+)\]$", line)
        if m:
            cur = m.group(1)
            if cur not in SECTIONS:
                raise Fail("unknown section [%s]" % cur)
            if cur in sections:
                raise Fail("duplicate section [%s]" % cur)
            sections[cur] = []
            continue
        if cur is None:
            raise Fail("option outside a section: %s" % line)
        if validate:
            if cur == "IPSET_TCP_PORTS":
                check_ports(line)
            else:
                check_line(line, cur)
        sections[cur].append(line)
    missing = [s for s in REQUIRED if not sections.get(s)]
    if missing:
        raise Fail("missing section: %s" % ", ".join("[%s]" % s for s in missing))
    return sections


def clean_list(text, kind):
    """Keep valid domains (hostlists) or networks (ipsets); drop the rest."""
    keep = []
    for raw in text.splitlines():
        line = raw.split("#", 1)[0].strip().lower()
        if not line:
            continue
        if kind == "ipset":
            try:
                keep.append(str(ipaddress.ip_network(line, strict=False)))
            except ValueError:
                pass
        else:
            exact = line.startswith("^")             # zapret: this host only, no subdomains
            line = line.lstrip("^").lstrip("*.").rstrip(".")
            if RE_DOMAIN.match(line):
                keep.append("^" + line if exact else line)
    return keep


def list_kind(name):
    return "ipset" if name.startswith("ipset") else "host"


def clean_hosts(text):
    """Flowseal hosts file -> kept '<ip> <domains>' lines. Anything else is dropped."""
    keep = []
    for raw in text.splitlines():
        line = raw.split("#", 1)[0].strip()
        if not line:
            continue
        parts = line.split()
        if len(parts) < 2:
            continue
        try:
            ipaddress.ip_address(parts[0])
        except ValueError:
            continue
        domains = [d.lower().rstrip(".") for d in parts[1:]]
        if not domains or any(not RE_DOMAIN.match(d) for d in domains):
            continue
        keep.append(parts[0] + " " + " ".join(domains))
    return keep


def apply_hosts_block(original_text, lines_or_None):
    """Rewrite /etc/hosts keeping everything outside the managed block.

    lines_or_None: list of host lines to install, or None to remove the block.
    Idempotent: re-applying the same lines changes nothing."""
    if original_text is None:
        original_text = ""
    lines = original_text.splitlines()
    out, i, removed = [], 0, False
    while i < len(lines):
        if lines[i].strip() == HOSTS_BEGIN:
            removed = True
            i += 1
            while i < len(lines) and lines[i].strip() != HOSTS_END:
                i += 1
            i += 1  # skip HOSTS_END itself when present
        else:
            out.append(lines[i])
            i += 1
    text = "\n".join(out)
    if text and not text.endswith("\n"):
        text += "\n"
    if lines_or_None is None:
        return text
    if text and not text.endswith("\n"):
        text += "\n"
    if text:
        text += "\n"
    text += HOSTS_BEGIN + "\n"
    for l in lines_or_None:
        text += l + "\n"
    text += HOSTS_END + "\n"
    return text


def hosts_state(hosts_path=HOSTS_FILE):
    """(on, lines): whether the managed block is present and how many entries it holds."""
    try:
        text = read_nofollow(hosts_path, MAX_LIST)
    except Fail:
        return False, 0
    if text is None:
        return False, 0
    inside, n = False, 0
    for line in text.splitlines():
        if line.strip() == HOSTS_BEGIN:
            inside = True
            continue
        if line.strip() == HOSTS_END:
            inside = False
            continue
        if inside and line.strip() and not line.strip().startswith("#"):
            n += 1
    return (HOSTS_BEGIN in text and HOSTS_END in text), n


# --------------------------------------------------------------- Flowseal (zapret1 / winws) presets

# A "full" preset is a whole nfqws2 profile list (Flowseal's own profiles) instead
# of the [SECTION] blocks above. Lines: `@tcp=`/`@udp=` (ports for nftables), and
# nfqws2 options with {{LISTS}}, {{GAME_TCP}}, {{GAME_UDP}} placeholders.
LIST_NAMES = BASE_LISTS + USER_LISTS
FULL_FILTERS = ("--filter-tcp", "--filter-udp", "--filter-l7", "--filter-l3", "--hostlist", "--hostlist-exclude",
                "--ipset", "--ipset-exclude", "--hostlist-domains", "--hostlist-exclude-domains")
GAME = ("{{GAME_TCP}}", "{{GAME_UDP}}")


def check_full_ports(val):
    parts = [p for p in val.split(",") if p not in GAME]
    if parts:
        check_ports(",".join(parts))


def check_full_line(line):
    if line == "--new":
        return
    if line.startswith(("@tcp=", "@udp=")):
        check_full_ports(line[5:])
        return
    opt, eq, val = line.partition("=")
    if opt in ("--filter-tcp", "--filter-udp"):
        check_full_ports(val)
    elif opt == "--filter-l7":
        if [v for v in val.split(",") if v not in L7]:
            raise Fail("unknown protocol: %s" % val)
    elif opt == "--filter-l3":
        if [v for v in val.split(",") if v not in ("ipv4", "ipv6")]:
            raise Fail("bad --filter-l3: %s" % val)
    elif opt in ("--hostlist", "--hostlist-exclude", "--ipset", "--ipset-exclude"):
        if not (val.startswith("{{LISTS}}/") and val.endswith(".txt") and val[10:-4] in LIST_NAMES):
            raise Fail("unknown list: %s" % val)
    elif opt in ("--hostlist-domains", "--hostlist-exclude-domains"):
        if [d for d in val.split(",") if not RE_DOMAIN.match(d)]:
            raise Fail("bad domain list: %s" % val)
    else:
        check_line(line, "FULL")


def parse_full(text):
    lines = []
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        check_full_line(line)
        lines.append(line)
    if not any(l.startswith("--lua-desync=") for l in lines):
        raise Fail("the preset has no desync at all")
    return {"full": lines}


def bat_tokens(text):
    """The winws command line of a Flowseal .bat as (option, value) pairs."""
    text = text.replace("\r", "")
    m = re.search(r'winws\.exe"\s+(.*?)(?:\n\s*\n|\Z)', text, re.S)
    if not m:
        raise Fail("no winws.exe command line")
    body = re.sub(r"\^\s*\n", " ", m.group(1))
    out = []
    for tok in re.findall(r'--[a-z0-9-]+(?:=(?:"[^"]*"|\S+))?', body):
        opt, _, val = tok.partition("=")
        out.append((opt, val.strip('"')))
    return out


def bat_path(val, kind):
    """%LISTS%x.txt -> {{LISTS}}/x.txt; %BIN%x.bin -> fs_ blob name; 0x.. stays."""
    if kind == "list":
        name = val.replace("%LISTS%", "")
        if not name.endswith(".txt") or name[:-4] not in LIST_NAMES:
            raise Fail("unknown list %s" % val)
        return "{{LISTS}}/" + name
    if RE_HEX.match(val):
        return val
    stem = val.replace("%BIN%", "")
    if not stem.endswith(".bin"):
        raise Fail("unsupported fake %s" % val)
    blob = "fs_" + stem[:-4].lower()
    if blob not in FS_BLOB_FILES:
        raise Fail("fake file not bundled: %s" % stem)
    return blob


def bat_ports(val):
    return val.replace("%GameFilterTCP%", "{{GAME_TCP}}").replace("%GameFilterUDP%", "{{GAME_UDP}}")


def translate_profile(opts):
    """One winws profile (between --new) as nfqws2 lines."""
    get = lambda k, d=None: next((v for o, v in opts if o == k), d)
    every = lambda k: [v for o, v in opts if o == k]
    out = []
    for o, v in opts:
        if o in ("--filter-tcp", "--filter-udp"):
            out.append("%s=%s" % (o, bat_ports(v)))
        elif o in ("--filter-l7", "--filter-l3", "--hostlist-domains", "--hostlist-exclude-domains"):
            out.append("%s=%s" % (o, v))
        elif o in ("--hostlist", "--hostlist-exclude", "--ipset", "--ipset-exclude"):
            out.append("%s=%s" % (o, bat_path(v, "list")))
    known = {"--filter-tcp", "--filter-udp", "--filter-l7", "--filter-l3", "--hostlist", "--hostlist-exclude",
             "--ipset", "--ipset-exclude", "--hostlist-domains", "--hostlist-exclude-domains", "--dpi-desync",
             "--dpi-desync-repeats", "--dpi-desync-fooling", "--dpi-desync-badseq-increment", "--dpi-desync-fake-tls",
             "--dpi-desync-fake-http", "--dpi-desync-fake-quic", "--dpi-desync-fake-discord", "--dpi-desync-fake-stun",
             "--dpi-desync-fake-unknown", "--dpi-desync-fake-unknown-udp", "--dpi-desync-fake-tls-mod",
             "--dpi-desync-split-pos", "--dpi-desync-split-seqovl", "--dpi-desync-split-seqovl-pattern",
             "--dpi-desync-fakedsplit-pattern", "--dpi-desync-hostfakesplit-mod", "--dpi-desync-cutoff",
             "--dpi-desync-any-protocol", "--ip-id"}
    unknown = sorted({o for o, _ in opts} - known)
    if unknown:
        raise Fail("unsupported winws options: %s" % ", ".join(unknown))
    modes = [m for m in (get("--dpi-desync") or "").split(",") if m]
    if not modes:
        return out                                   # a pass-through profile
    tcp = get("--filter-tcp") is not None
    anyproto = get("--dpi-desync-any-protocol") == "1"
    cutoff = get("--dpi-desync-cutoff")
    if cutoff:
        if not re.match(r"^[nds]\d{1,6}$", cutoff):
            raise Fail("unsupported cutoff %s" % cutoff)
        # winws: desync only before N. "<nN" is the same range, but nfqws2 splits
        # @config files with wordexp, where an unquoted "<" is a syntax error.
        if int(cutoff[1:]) < 2:
            raise Fail("unsupported cutoff %s" % cutoff)
        out.append("--out-range=-%s%d" % (cutoff[0], int(cutoff[1:]) - 1))
    fool = []
    for f in (get("--dpi-desync-fooling") or "").split(","):
        if f == "ts":
            fool.append("tcp_ts=-1000")
        elif f == "md5sig":
            fool.append("tcp_md5")
        elif f == "badseq":
            fool.append("tcp_seq=%s:tcp_ack=-66000" % int(get("--dpi-desync-badseq-increment", "-10000"), 0))
        elif f == "badsum":
            fool.append("badsum")
        elif f:
            raise Fail("unsupported fooling %s" % f)
    fool = ":".join(fool)
    ipid = "ip_id=zero" if get("--ip-id") == "zero" else ""
    repeats = get("--dpi-desync-repeats")
    mod = get("--dpi-desync-fake-tls-mod")
    mod = "" if mod in (None, "none") else mod

    def call(func, *params):
        return "--lua-desync=" + ":".join([func] + [p for p in params if p])

    for mode in modes:
        if mode == "fake":
            fakes = []
            if tcp:
                tls = every("--dpi-desync-fake-tls") or ["!"]
                for v in tls:
                    if v in ("!", "^!"):
                        if v == "^!":
                            fakes.append(("tls_client_hello", None, call("tls_client_hello_clone", "blob=" + FS_CLONE)))
                        fakes.append(("tls_client_hello", FS_CLONE if v == "^!" else "fake_default_tls", True))
                    else:
                        b = bat_path(v, "bin")
                        fakes.append(("tls_client_hello", b, b.startswith("fs_tls_")))
                for v in every("--dpi-desync-fake-http") or ["!"]:
                    fakes.append(("http_req", "fake_default_http" if v == "!" else bat_path(v, "bin"), False))
                if anyproto:
                    for v in every("--dpi-desync-fake-unknown"):
                        fakes.append(("unknown", bat_path(v, "bin"), False))
            else:
                explicit = any(every(k) for k in ("--dpi-desync-fake-discord", "--dpi-desync-fake-stun",
                                                  "--dpi-desync-fake-unknown-udp"))
                # winws' default QUIC fake only where the profile names no other UDP fake
                for v in every("--dpi-desync-fake-quic") or ([] if explicit else ["!"]):
                    fakes.append(("quic_initial", "fake_default_quic" if v == "!" else bat_path(v, "bin"), False))
                for v in every("--dpi-desync-fake-discord"):
                    fakes.append(("discord_ip_discovery", bat_path(v, "bin"), False))
                for v in every("--dpi-desync-fake-stun"):
                    fakes.append(("stun", bat_path(v, "bin"), False))
                if anyproto:
                    for v in every("--dpi-desync-fake-unknown-udp"):
                        fakes.append(("unknown", bat_path(v, "bin"), False))
            for payload, blob, tlsmod in fakes:
                out.append("--payload=" + payload)
                if blob is None:
                    out.append(tlsmod)                    # the clone call itself
                    continue
                out.append(call("fake", "blob=" + blob, fool, "repeats=" + repeats if repeats else "",
                                "tls_mod=" + mod if tlsmod and mod else "", ipid))
        elif mode in ("multisplit", "multidisorder", "fakedsplit", "hostfakesplit"):
            out.append("--payload=" + ("all" if anyproto else "known"))
            pos = get("--dpi-desync-split-pos", "")
            seqovl = get("--dpi-desync-split-seqovl")
            pat = get("--dpi-desync-split-seqovl-pattern")
            if mode in ("multisplit", "multidisorder"):
                out.append(call(mode, "pos=" + pos if pos else "", "seqovl=" + seqovl if seqovl else "",
                                "seqovl_pattern=" + bat_path(pat, "bin") if pat else "", ipid))
            elif mode == "fakedsplit":
                fpat = get("--dpi-desync-fakedsplit-pattern")
                out.append(call(mode, "pos=" + pos.split(",")[0] if pos else "",
                                "pattern=" + bat_path(fpat, "bin") if fpat else "", fool, ipid))
            else:
                hmod = dict(kv.partition("=")[::2] for kv in (get("--dpi-desync-hostfakesplit-mod") or "").split(",") if kv)
                # winws altorder has no nfqws2 counterpart; the split itself is kept
                out.append(call(mode, "host=" + hmod["host"] if hmod.get("host") else "", fool, ipid))
        elif mode == "syndata":
            out.append("--payload=empty")
            out.append(call("syndata"))
        else:
            raise Fail("unsupported desync mode %s" % mode)
    return out


def translate_bat(text, title=""):
    """A Flowseal general*.bat as a full preset (text)."""
    toks = bat_tokens(text)
    wf = {o: bat_ports(v) for o, v in toks if o in ("--wf-tcp", "--wf-udp")}
    profiles, cur = [], []
    for o, v in toks:
        if o in ("--wf-tcp", "--wf-udp", "--wf-raw-part", "--wf-l3"):
            continue
        if o == "--new":
            profiles.append(cur)
            cur = []
        else:
            cur.append((o, v))
    profiles.append(cur)
    lines = ["# Flowseal zapret-discord-youtube, translated to nfqws2: %s" % title,
             "@tcp=" + wf.get("--wf-tcp", "80,443"), "@udp=" + wf.get("--wf-udp", "443")]
    body = []
    for prof in profiles:
        if body:
            body.append("--new")
        body += translate_profile(prof)
    text = "\n".join(lines + body) + "\n"
    parse_full(text)
    return text


def fs_slug(filename):
    """'general (FAKE TLS AUTO ALT2).bat' -> 'fs-general-fake-tls-auto-alt2'."""
    base = re.sub(r"\.bat$", "", filename, flags=re.I).lower()
    slug = "fs-" + re.sub(r"[^a-z0-9]+", "-", base).strip("-")
    if not RE_NAME.match(slug):
        raise Fail("name too long: %s" % filename)
    return slug


def render_full(lines, settings, engine, lists, counts):
    """A full preset as nfqws2 args and (tcp, udp) nft ports."""
    game_tcp = game_filter(settings, "tcp")
    game_udp = game_filter(settings, "udp")
    loaded = ["--ipset=%s/%s.txt" % (lists, n) for n in ("ipset-all", "ipset-all-user") if counts.get(n)]
    ipset_all = {"loaded": loaded or ["--ipset=%s/ipset-none.txt" % lists],
                 "none": ["--ipset=%s/ipset-none.txt" % lists], "any": []}[settings["ipset"]]
    args = ["--blob=%s:@%s" % (b, os.path.join(FS_FAKES, f)) for b, f in sorted(FS_BLOB_FILES.items())]
    ports = {"tcp": [], "udp": []}
    for line in lines:
        if line.startswith(("@tcp=", "@udp=")):
            game = game_tcp if line[1] == "t" else game_udp
            parts = [game if p in GAME else p for p in line[5:].split(",")]
            ports[line[1:4]] = [p for p in parts if p != "12"]
            continue
        if line == "--ipset={{LISTS}}/ipset-all.txt":
            args += ipset_all
            continue
        args.append(line.replace("{{LISTS}}", lists).replace("{{GAME_TCP}}", game_tcp).replace("{{GAME_UDP}}", game_udp))
    discord_fake = settings.get("discordFake", "default")
    game_fake = settings.get("gameFake", "default")
    if discord_fake not in ("default", None) and discord_fake in fake_choices():
        args = [a.replace("blob=fs_active_discord_udp", "blob=" + discord_fake) if a.startswith("--lua-desync=") else a
                for a in args]
    if game_fake not in ("default", None) and game_fake in fake_choices():
        args = [a.replace("blob=fs_active_game_udp", "blob=" + game_fake) if a.startswith("--lua-desync=") else a
                for a in args]
    return args, (merge_ports(ports["tcp"] or ["80", "443"]), merge_ports(ports["udp"] or ["443"]))


# --------------------------------------------------------------- rendering

def merge_ports(parts):
    """'80', '1024-65535', ... into sorted, non-overlapping nft set elements."""
    spans = []
    for part in parts:
        for p in str(part).split(","):
            a, _, b = p.partition("-")
            spans.append((int(a), int(b or a)))
    spans.sort()
    merged = []
    for a, b in spans:
        if merged and a <= merged[-1][1] + 1:
            merged[-1] = (merged[-1][0], max(merged[-1][1], b))
        else:
            merged.append((a, b))
    return ["%d" % a if a == b else "%d-%d" % (a, b) for a, b in merged]


def voice_profile(settings, sections):
    if settings["voice"] == "compatible" and sections.get("VOICE_COMPATIBLE"):
        return list(sections["VOICE_COMPATIBLE"])
    if settings["voice"] == "compatible":
        return ["--filter-udp=1024-65535", "--filter-l7=stun,discord", "--payload=stun,discord_ip_discovery",
                "--lua-desync=fake:blob=discord_voice:repeats=3", "--payload=all", "--out-range=n2-n4",
                "--lua-desync=fake:blob=discord_voice:repeats=10"]
    if settings["voice"] == "standard":
        return ["--filter-udp=1024-65535", "--filter-l7=stun,discord", "--payload=stun,discord_ip_discovery",
                "--lua-desync=fake:blob=0x00000000000000000000000000000000:repeats=2"]
    return ["--filter-udp=1024-65535", "--filter-l7=stun,discord"]


def ports_for(settings, sections):
    """(tcp, udp) ports nftables hands to nfqws2."""
    ipset_tcp = [p for p in sections.get("IPSET_TCP_PORTS", [])]
    tcp = ["80", "443", "2053", "2083", "2087", "2096", "8443"] + ipset_tcp
    if settings["game"] in ("tcp", "all"):
        tcp.append(game_filter(settings, "tcp"))
    if settings["game"] in ("udp", "all"):
        udp = ["443", game_filter(settings, "udp")]
    elif settings["voice"] == "compatible" and not sections.get("VOICE_COMPATIBLE"):
        udp = ["443", "1024-65535"]
    else:
        udp = ["443", "19294-19344", "50000-50100"]
        for line in sections.get("VOICE_COMPATIBLE", []):
            if line.startswith("--filter-udp="):
                udp.append(line.split("=", 1)[1])
    return merge_ports(tcp), merge_ports(udp)


def drop_empty_user_lists(args, lists, counts):
    # an empty user list would only add noise; base lists always have entries
    return [a for a in args if not any(a == "%s=%s/%s.txt" % (o, lists, n) for n in USER_LISTS
                                       if not counts.get(n) for o in ("--hostlist", "--hostlist-exclude", "--ipset-exclude"))]


def render_args(preset, sections, settings, engine, lists, fake_dirs, counts):
    """The full nfqws2 command line (without the binary)."""
    def blob_path(f):
        for d in fake_dirs:
            if os.path.exists(os.path.join(d, f)):
                return os.path.join(d, f)
        return os.path.join(fake_dirs[0], f)

    args = ["--qnum=%d" % QNUM, "--user=nobody", "--fwmark=0x%x" % MARK, "--ctrack-disable=0",
            "--ipcache-lifetime=8400", "--ipcache-hostname=1",
            "--lua-init=@%s/lua/zapret-lib.lua" % engine, "--lua-init=@%s/lua/zapret-antidpi.lua" % engine]
    args += ["--blob=%s:@%s" % (name, blob_path(f)) for name, f in sorted(BLOB_FILES.items())]

    def sect(name, fallback="TCP_TLS"):
        return list(sections.get(name) or sections[fallback])

    loaded = ["--ipset=%s/%s.txt" % (lists, n) for n in ("ipset-all", "ipset-all-user") if counts.get(n)]
    ipset_include = {"loaded": loaded or ["--ipset=%s/ipset-none.txt" % lists],
                     "none": ["--ipset=%s/ipset-none.txt" % lists], "any": []}[settings["ipset"]]
    discord_web = []
    if preset.startswith("custom-"):
        discord_web = ["--filter-tcp=443", "--hostlist=%s/list-discord-web.txt" % lists,
                       "--payload=tls_client_hello", "--out-range=-d10"] + sect("DISCORD_WEB_TLS") + ["--new"]
    blocks = {
        "QUIC": sect("QUIC"), "TCP_HTTP": sect("TCP_HTTP"), "TCP_TLS": sect("TCP_TLS"),
        "TCP_GENERIC": sect("TCP_GENERIC"), "GOOGLE_TLS": sect("GOOGLE_TLS"),
        "DISCORD_MEDIA_TLS": sect("DISCORD_MEDIA_TLS"), "DISCORD_WEB_PROFILE": discord_web,
        "VOICE_UDP_PROFILE": voice_profile(settings, sections), "IPSET_INCLUDE": ipset_include,
    }
    tcp_extra = ["80,443"] + sections.get("IPSET_TCP_PORTS", [])
    inline = {
        "{{LISTS}}": lists,
        "{{GAME_TCP}}": game_filter(settings, "tcp"),
        "{{GAME_UDP}}": game_filter(settings, "udp"),
        "{{IPSET_TCP_FILTER}}": ",".join(tcp_extra),
    }
    with open(os.path.join(DATA, "profiles.txt"), encoding="utf-8") as f:
        template = f.read()
    for raw in template.splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        m = re.match(r"^\{\{([A-Z_]+)\}\}$", line)
        if m:
            args += blocks[m.group(1)]
            continue
        for k, v in inline.items():
            line = line.replace(k, v)
        args.append(line)
    # an empty user list would only add noise; base lists always have entries
    args = drop_empty_user_lists(args, lists, counts)
    while args and args[-1] == "--new":
        args.pop()
    return args


def render_nft(tcp, udp, ipv6=True):
    """Queue the first packets of matching connections to nfqws2. Loopback and
    L3 tunnels (ARPHRD_NONE: TUN, WireGuard, Tailscale, omarchy-xray) are left
    alone: what enters a VPN tunnel is not seen by the DPI, and desynced
    packets would only break the tunnel's own TCP stack."""
    t, u = ", ".join(tcp), ", ".join(udp)
    skip6 = "" if ipv6 else "\t\tmeta nfproto ipv6 return\n"
    return (
        "table inet {tb} {{}}\n"
        "delete table inet {tb}\n"
        "table inet {tb} {{\n"
        "\tchain post {{\n"
        "\t\ttype filter hook postrouting priority 101; policy accept;\n"
        "\t\toifname \"lo\" return\n"
        "\t\tmeta oiftype 65534 return\n{skip6}"
        "\t\tmeta mark & {mark:#x} != 0 return\n"
        "\t\ttcp dport {{ {t} }} ct original packets 1-20 queue num {q} bypass\n"
        "\t\tudp dport {{ {u} }} ct original packets 1-5 queue num {q} bypass\n"
        "\t}}\n"
        "\tchain pre {{\n"
        "\t\ttype filter hook prerouting priority filter; policy accept;\n"
        "\t\tiifname \"lo\" return\n"
        "\t\tmeta iiftype 65534 return\n{skip6}"
        "\t\ttcp sport {{ {t} }} ct reply packets 1-10 queue num {q} bypass\n"
        "\t\ttcp sport {{ {t} }} tcp flags & (syn | ack) == (syn | ack) queue num {q} bypass\n"
        "\t}}\n"
        "\tchain predefrag {{\n"
        "\t\ttype filter hook output priority -401; policy accept;\n"
        "\t\tmeta mark & {mark:#x} != 0 notrack\n"
        "\t}}\n"
        "}}\n").format(tb=NFT_TABLE, mark=MARK, t=t, u=u, q=QNUM, skip6=skip6)


# --------------------------------------------------------------- user side: state

def var_path(*parts):
    return os.path.join(VAR, *parts)


def installed():
    rec = load_record()
    return bool(rec) and rec.get("uid") == os.getuid() and os.path.isdir(VAR)


def require_installed():
    if not installed():
        raise Fail("zapret2 is not set up yet: run setup first")


def load_settings():
    try:
        text = read_nofollow(var_path("settings.json"), MAX_SMALL)
        return clean_settings(json.loads(text) if text else {})
    except (Fail, ValueError):
        return dict(DEFAULTS)


def save_settings(s):
    atomic_write(var_path("settings.json"), json.dumps(clean_settings(s), indent=1) + "\n")


def custom_names():
    try:
        names = sorted(f[:-4] for f in os.listdir(var_path("custom")) if f.endswith(".txt"))
    except OSError:
        return []
    return [n for n in names if n.startswith("my-") and RE_NAME.match(n)]


def flowseal_names():
    found = set()
    for base in (var_path("flowseal"), os.path.join(DATA, "presets", "flowseal")):
        try:
            files = os.listdir(base)
        except OSError:
            continue
        for f in files:
            if f.endswith(".txt"):
                n = f[:-4]
                if n.startswith("fs-") and RE_NAME.match(n):
                    found.add(n)
    return sorted(found)


def all_presets():
    out = [{"name": n, "about": "Flowseal " + n[len("fs-"):].replace("-", " "), "group": "flowseal"}
           for n in flowseal_names()]
    out += [{"name": n, "about": a, "group": "next"} for n, a in PRESETS.items()]
    out += [{"name": n, "about": "own strategy", "group": "custom"} for n in custom_names()]
    return out


def unit_state(unit):
    r = sh("systemctl", "show", "-p", "ActiveState,SubState,Result,NRestarts,ExecMainStatus", unit, timeout=10)
    st = dict(l.split("=", 1) for l in r.stdout.splitlines() if "=" in l)
    return st


def systemctl(verb, unit):
    r = sh("systemctl", "--no-ask-password", verb, unit, timeout=60)
    if r.returncode != 0:
        raise Fail((r.stderr.strip().splitlines() or ["systemctl %s failed" % verb])[-1])


def state_dir():
    d = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "omarchy-zapret2")
    os.makedirs(d, mode=0o700, exist_ok=True)
    return d


def load_state(name, default):
    try:
        text = read_nofollow(os.path.join(state_dir(), name), 4 * 1024 * 1024)
        v = json.loads(text) if text else default
        return v if isinstance(v, type(default)) else default
    except (Fail, ValueError):
        return default


def save_state(name, obj):
    atomic_write(os.path.join(state_dir(), name), json.dumps(obj, ensure_ascii=False), mode=0o600)


def cmd_status():
    rec = load_record()
    st = {"ok": True, "installed": installed(), "engine": rec.get("version") if rec else None,
          "appCurrent": True, "settings": load_settings(),
          "presets": all_presets(), "fakeChoices": ["default"] + fake_choices(),
          "hosts": hosts_state()[0],
          "check": load_state("check.json", {}), "autopick": load_state("autopick.json", {})}
    if rec and rec.get("uid") != os.getuid():
        st["error"] = "zapret2 is set up for another user on this machine"
    if st["installed"]:
        files = rec.get("files", {})
        own = files.get(SYS_APP + "/bin/omarchy-zapret2")
        st["appCurrent"] = own == sha256_file(SELF) if own else False
        u = unit_state(UNIT)
        st["active"] = u.get("ActiveState", "unknown")
        st["sub"] = u.get("SubState", "")
        st["restarts"] = int(u.get("NRestarts", "0") or 0)
        st["failed"] = u.get("ActiveState") == "failed"
        b = unit_state(BC_UNIT)
        st["blockcheck"] = b.get("ActiveState", "inactive")
    else:
        st["active"] = "inactive"
        st["blockcheck"] = "inactive"
    if st["active"] == "failed":
        st["error"] = "The bypass stopped with an error: open the logs"
    out(st)


def cmd_presets():
    out({"ok": True, "presets": all_presets()})


def cmd_presets_show(args):
    if len(args) != 1:
        raise Fail("usage: presets show <name>")
    raw = args[0]
    if raw in PRESETS:
        try:
            with open(os.path.join(DATA, "presets", raw + ".txt"), encoding="utf-8") as f:
                text = f.read()
        except OSError:
            raise Fail("no such strategy: %s" % raw)
        out({"ok": True, "name": raw, "text": text})
        return
    if raw.startswith("fs-"):
        if not RE_NAME.match(raw):
            raise Fail("no such strategy: %s" % raw)
        text = read_nofollow(var_path("flowseal", raw + ".txt"), MAX_SMALL * 4)
        if text is None:
            try:
                with open(os.path.join(DATA, "presets", "flowseal", raw + ".txt"), encoding="utf-8") as f:
                    text = f.read()
            except OSError:
                raise Fail("no such strategy: %s" % raw)
        out({"ok": True, "name": raw, "text": text})
        return
    name = custom_name(raw)
    text = read_nofollow(var_path("custom", name + ".txt"), MAX_SMALL)
    if text is None:
        raise Fail("no such strategy: %s" % raw)
    out({"ok": True, "name": name, "text": text})


FS_CONTENTS_API = "https://api.github.com/repos/Flowseal/zapret-discord-youtube/contents/"
FS_RAW_PREFIX = "https://raw.githubusercontent.com/Flowseal/"


def cmd_presets_update():
    require_installed()
    try:
        entries = json.loads(http_get(FS_CONTENTS_API, MAX_LIST).decode("utf-8", "replace"))
    except (Fail, ValueError) as e:
        raise Fail("download failed: %s" % e)
    if not isinstance(entries, list):
        raise Fail("unexpected listing from GitHub")
    updated, skipped = [], {}
    for e in entries:
        if not isinstance(e, dict):
            continue
        fname = e.get("name", "")
        if not re.match(r"^general.*\.bat$", fname):
            continue
        url = e.get("download_url", "")
        if not (isinstance(url, str) and url.startswith(FS_RAW_PREFIX)):
            skipped[fname] = "unexpected download location"
            continue
        try:
            slug = fs_slug(fname)
            text = http_get(url, MAX_SMALL * 4).decode("utf-8", "replace")
            text = translate_bat(text, fname)
        except (Fail, ValueError) as ex:
            skipped[fname] = str(ex)
            continue
        atomic_write(var_path("flowseal", slug + ".txt"), text)
        updated.append(slug)
    updated.sort()
    try:
        current = [f for f in os.listdir(var_path("flowseal")) if f.startswith("fs-") and f.endswith(".txt")]
    except OSError:
        current = []
    for f in current:
        if f[:-4] not in updated:
            try:
                os.unlink(os.path.join(var_path("flowseal"), f))
            except OSError:
                pass
    out({"ok": True, "updated": updated, "skipped": skipped})
    restart_if_active()


def cmd_on():
    require_installed()
    st = unit_state(BC_UNIT)
    if st.get("ActiveState") in ("active", "activating"):
        raise Fail("blockcheck is running: stop it first")
    systemctl("start", UNIT)
    wait_active()
    out({"ok": True, "active": "active"})


def wait_active(timeout=8.0):
    end = time.time() + timeout
    while time.time() < end:
        st = unit_state(UNIT)
        a = st.get("ActiveState")
        if a == "active" and st.get("SubState") == "running":
            time.sleep(0.5)                       # nft rules are up, let nfqws2 bind the queue
            if unit_state(UNIT).get("ActiveState") == "active":
                return
        if a == "failed":
            break
        time.sleep(0.3)
    tail = journal(8)
    raise Fail("the bypass did not start" + (": " + tail[-1] if tail else ""))


def cmd_off():
    require_installed()
    systemctl("stop", UNIT)
    out({"ok": True, "active": "inactive"})


def restart_if_active():
    if unit_state(UNIT).get("ActiveState") in ("active", "activating", "failed"):
        systemctl("restart", UNIT)
        wait_active()
        return True
    return False


def cmd_restart():
    require_installed()
    systemctl("restart", UNIT)
    wait_active()
    out({"ok": True, "active": "active"})


def cmd_set(key, value):
    require_installed()
    s = load_settings()
    if key == "preset":
        if value not in {p["name"] for p in all_presets()}:
            raise Fail("no such strategy: %s" % value)
        s["preset"] = value
    elif key in ENUMS:
        if value not in ENUMS[key]:
            raise Fail("%s takes one of: %s" % (key, ", ".join(ENUMS[key])))
        s[key] = value
    elif key in ("ipv6", "autostart"):
        if value not in ("on", "off"):
            raise Fail("%s takes on or off" % key)
        s[key] = value == "on"
    elif key.lower() in ("gametcp", "gameudp"):
        setting = "gameTcp" if key.lower() == "gametcp" else "gameUdp"
        if not valid_game_ports(value):
            raise Fail("%s takes a port list like 1024-65535 (up to %d items)" % (key.lower(), GAME_PORT_MAX_ITEMS))
        s[setting] = value
    elif key.lower() in ("discordfake", "gamefake"):
        setting = "discordFake" if key.lower() == "discordfake" else "gameFake"
        if value != "default" and value not in fake_choices():
            raise Fail("%s takes default or one of: %s" % (key.lower(), ", ".join(["default"] + fake_choices())))
        s[setting] = value
    else:
        raise Fail("unknown setting: %s" % key)
    save_settings(s)
    restarted = key != "autostart" and restart_if_active()
    out({"ok": True, "settings": load_settings(), "restarted": restarted})


# --------------------------------------------------------------- custom strategies and lists

def read_stdin(cap):
    data = sys.stdin.buffer.read(cap + 1)
    if len(data) > cap:
        raise Fail("input is larger than %d bytes" % cap)
    return data.decode("utf-8", "replace")


def custom_name(name):
    name = name if name.startswith("my-") else "my-" + name
    if not RE_NAME.match(name):
        raise Fail("name: lowercase letters, digits and dashes, up to 32")
    return name


def cmd_custom(args):
    require_installed()
    if not args:
        raise Fail("usage: custom save|show|rm <name>")
    verb = args[0]
    if verb == "list":
        out({"ok": True, "custom": custom_names()})
        return
    if len(args) < 2:
        raise Fail("usage: custom %s <name>" % verb)
    name = custom_name(args[1])
    path = var_path("custom", name + ".txt")
    if verb == "save":
        text = read_stdin(MAX_SMALL)
        parse_preset(text)
        atomic_write(path, text.strip() + "\n")
        out({"ok": True, "name": name})
    elif verb == "show":
        text = read_nofollow(path, MAX_SMALL)
        if text is None:
            raise Fail("no such strategy: %s" % name)
        out({"ok": True, "name": name, "text": text})
    elif verb == "rm":
        s = load_settings()
        if s["preset"] == name:
            raise Fail("this strategy is in use: pick another one first")
        try:
            os.unlink(path)
        except FileNotFoundError:
            pass
        out({"ok": True})
    else:
        raise Fail("usage: custom save|show|rm <name>")


def cmd_list(args):
    require_installed()
    if len(args) < 2 or args[0] not in ("show", "save"):
        raise Fail("usage: list show|save <name>")
    name = args[1]
    if name in USER_LISTS:
        path = var_path("lists", name + ".txt")
    elif name in BASE_LISTS and args[0] == "show":
        path = var_path("lists", "upstream", name + ".txt")
        if not os.path.exists(path):
            path = os.path.join(DATA, "lists", name + ".txt")
    else:
        raise Fail("lists you can edit: %s" % ", ".join(USER_LISTS))
    if args[0] == "show":
        text = read_nofollow(path, MAX_LIST) or ""
        lines = [l for l in text.splitlines() if l.strip()]
        out({"ok": True, "name": name, "count": len(lines),
             "text": "\n".join(lines[:5000]), "truncated": len(lines) > 5000})
        return
    text = read_stdin(MAX_LIST)
    lines = clean_list(text, list_kind(name))
    raw = [l for l in text.splitlines() if l.split("#", 1)[0].strip()]
    atomic_write(path, "\n".join(lines) + ("\n" if lines else ""))
    restarted = restart_if_active()
    out({"ok": True, "name": name, "count": len(lines), "dropped": len(raw) - len(lines), "restarted": restarted})


def http_get(url, cap, timeout=30):
    if not url.startswith("https://"):
        raise Fail("only https downloads")
    req = urllib.request.Request(url, headers={"User-Agent": "omarchy-zapret2", "Accept": "*/*"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            if not r.geturl().startswith("https://"):
                raise Fail("redirected away from https")
            data = r.read(cap + 1)
    except urllib.error.URLError as e:
        raise Fail("download failed: %s" % getattr(e, "reason", e))
    if len(data) > cap:
        raise Fail("download is larger than %d bytes" % cap)
    return data


def cmd_lists_update():
    require_installed()
    updated, skipped = {}, {}
    for name, rel in UPSTREAM_LISTS.items():
        try:
            text = http_get(UPSTREAM + rel, MAX_LIST).decode("utf-8", "replace")
        except Fail as e:
            skipped[name] = str(e)
            continue
        lines = clean_list(text, list_kind(name))
        if len(lines) < 3:
            skipped[name] = "upstream looks empty, kept the current one"
            continue
        updated[name] = lines
    if not updated:
        raise Fail("no list could be updated: " + "; ".join("%s: %s" % kv for kv in skipped.items()))
    for name, lines in updated.items():
        atomic_write(var_path("lists", "upstream", name + ".txt"), "\n".join(lines) + "\n")
    restarted = restart_if_active()
    out({"ok": True, "updated": {k: len(v) for k, v in updated.items()}, "skipped": skipped, "restarted": restarted})


def cmd_hosts(args):
    verb = args[0] if args else "status"
    if verb == "status":
        on, n = hosts_state()
        out({"ok": True, "on": on, "lines": n})
        return
    require_installed()
    if verb == "on":
        data = http_get(HOSTS_URL, MAX_HOSTS)
        lines = clean_hosts(data.decode("utf-8", "replace"))
        if not lines:
            raise Fail("the upstream hosts file looks empty, kept the current one")
        text = "\n".join(lines) + "\n"
        d = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir(), "omarchy-zapret2")
        os.makedirs(d, mode=0o700, exist_ok=True)
        os.chmod(d, 0o700)
        path = os.path.join(d, "hosts.txt")
        atomic_write(path, text, mode=0o600)
        sha = hashlib.sha256(text.encode("utf-8")).hexdigest()
        res = escalated("Hosts", "_hosts", "on", "--file", path, "--sha256", sha)
        try:
            os.unlink(path)
        except OSError:
            pass
        out({"ok": True, "on": True, "lines": len(lines), "result": res})
    elif verb == "off":
        res = escalated("Hosts", "_hosts", "off")
        out({"ok": True, "on": False, "result": res})
    else:
        raise Fail("usage: hosts on|off|status")


def cmd_hosts_root(args):
    require_root()
    uid = caller_uid()
    opts = dict(zip(args[::2], args[1::2]))
    if os.path.islink(HOSTS_FILE):
        raise Fail("%s is a symlink: refusing" % HOSTS_FILE)
    if args[:1] == ["off"]:
        text = read_nofollow(HOSTS_FILE, MAX_LIST) or ""
        atomic_write(HOSTS_FILE, apply_hosts_block(text, None), mode=0o644)
        out({"ok": True, "on": False})
        return
    if args[:1] != ["on"]:
        raise Fail("usage: _hosts on|off")
    path, sha = opts.get("--file", ""), opts.get("--sha256", "")
    if not RE_SHA.match(sha or ""):
        raise Fail("bad checksum")
    text = read_nofollow(path, MAX_HOSTS, owner=uid)
    if text is None:
        raise Fail("hosts file is gone")
    if hashlib.sha256(text.encode("utf-8")).hexdigest() != sha:
        raise Fail("the hosts file does not match its checksum")
    lines = clean_hosts(text)
    if not lines:
        raise Fail("the hosts file looks empty")
    current = read_nofollow(HOSTS_FILE, MAX_LIST) or ""
    atomic_write(HOSTS_FILE, apply_hosts_block(current, lines), mode=0o644)
    out({"ok": True, "on": True, "lines": len(lines)})


DISCORD_DIRS = ("discord", "discordcanary", "discordptb")
DISCORD_CACHE_SUBS = ("Cache", "Code Cache", "GPUCache")


def cmd_discord_cache(args):
    if not args or args[0] != "clear":
        raise Fail("usage: discord-cache clear")
    bases = [os.path.expanduser("~/.config/" + d) for d in DISCORD_DIRS]
    bases.append(os.path.expanduser("~/.var/app/com.discordapp.Discord/config/discord"))
    cleared = []
    for base in bases:
        for sub in DISCORD_CACHE_SUBS:
            target = os.path.join(base, sub)
            if os.path.islink(target):
                raise Fail("%s is a symlink: refusing" % target)
            if os.path.isdir(target):
                shutil.rmtree(target, ignore_errors=False)
                cleared.append(target)
    out({"ok": True, "cleared": cleared})


# --------------------------------------------------------------- checks and autopick

def curl_probe(url, http3=False, timeout=6):
    curl = tool("curl")
    args = [curl, "-sS", "-o", "/dev/null", "--max-time", str(timeout), "--connect-timeout", "4",
            "-w", "%{http_code} %{time_total}", "-A", "Mozilla/5.0"]
    args += ["--http3-only"] if http3 else ["--http1.1"]
    r = sh(*(args + [url]), timeout=timeout + 3)
    parts = r.stdout.split()
    code = parts[0] if parts else "000"
    ok = r.returncode == 0 and code != "000"
    err = "" if ok else (r.stderr.strip().splitlines() or ["curl exit %d" % r.returncode])[-1]
    return {"url": url, "ok": ok, "code": code, "time": float(parts[1]) if ok and len(parts) > 1 else None,
            "error": err.replace("curl: ", "")}


def has_http3():
    r = sh("curl", "--version", timeout=5)
    return "HTTP3" in r.stdout


def run_checks():
    with open(os.path.join(DATA, "targets.json"), encoding="utf-8") as f:
        targets = json.load(f)
    h3 = has_http3()
    jobs = []
    for cat, t in targets.items():
        for url in t["urls"]:
            jobs.append((cat, url, False))
            if h3 and cat == "youtube":
                jobs.append((cat, url, True))
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as ex:
        results = list(ex.map(lambda j: (j[0], j[2], curl_probe(j[1], j[2])), jobs))
    cats = {}
    for cat, t in targets.items():
        rs = [dict(r, http3=h) for c, h, r in results if c == cat]
        cats[cat] = {"label": t["label"], "ok": sum(1 for r in rs if r["ok"]), "total": len(rs), "results": rs}
    score = sum(c["ok"] for c in cats.values())
    total = sum(c["total"] for c in cats.values())
    return {"time": int(time.time()), "score": score, "total": total, "categories": cats}


def cmd_check():
    res = run_checks()
    if installed():
        res["preset"] = load_settings()["preset"]
        res["active"] = unit_state(UNIT).get("ActiveState") == "active"
    save_state("check.json", res)
    out(dict(res, ok=True))


def cmd_autopick(args):
    require_installed()
    if unit_state(BC_UNIT).get("ActiveState") in ("active", "activating"):
        raise Fail("blockcheck is running: stop it first")
    names = [p["name"] for p in all_presets() if p["group"] != "custom"]
    valid = set(names) | set(custom_names())
    names = [n for n in (args[0].split(",") if args else names) if n in valid]
    if not names:
        raise Fail("no strategies to try")
    s = load_settings()
    before = s["preset"]
    progress(step=0, of=len(names), preset="(off)")
    systemctl("stop", UNIT)
    base = run_checks()                            # what opens without any bypass
    baseline = {"preset": "(off)", "score": base["score"], "total": base["total"],
                "categories": {k: [v["ok"], v["total"]] for k, v in base["categories"].items()}}
    progress(step=0, of=len(names), preset="(off)", result=baseline)
    rows = []
    best = None
    for i, name in enumerate(names):
        progress(step=i + 1, of=len(names), preset=name)
        s["preset"] = name
        save_settings(s)
        try:
            systemctl("restart", UNIT)
            wait_active()
            res = run_checks()
            row = {"preset": name, "score": res["score"], "total": res["total"],
                   "categories": {k: [v["ok"], v["total"]] for k, v in res["categories"].items()}}
        except Fail as e:
            row = {"preset": name, "score": -1, "total": 0, "error": str(e), "categories": {}}
        rows.append(row)
        progress(step=i + 1, of=len(names), preset=name, result=row)
        if best is None or row["score"] > best["score"]:
            best = row
        if row["total"] and row["score"] == row["total"]:
            break                                  # everything answers: no need to go on
    chosen = best["preset"] if best and best["score"] > 0 else before
    s["preset"] = chosen
    save_settings(s)
    not_needed = bool(best) and best["score"] <= baseline["score"]
    if not_needed:
        systemctl("stop", UNIT)
    else:
        systemctl("restart", UNIT)
        wait_active()
    result = {"time": int(time.time()), "rows": rows, "chosen": chosen, "baseline": baseline,
              "notNeeded": not_needed}
    save_state("autopick.json", result)
    out(dict(result, ok=True))


# --------------------------------------------------------------- blockcheck (user side)

RE_FOUND = re.compile(r"^!!!!! (curl_test_[a-z0-9_]+): working strategy found for (ipv[46]) (\S+) : nfqws2 (.*?) !!!!!$")


def parse_blockcheck(text):
    found = []
    for line in text.splitlines():
        m = RE_FOUND.match(line.strip())
        if m:
            found.append({"test": m.group(1), "ip": m.group(2), "domain": m.group(3), "args": m.group(4)})
    return found


def strategy_from_found(item):
    """A blockcheck finding as a custom strategy, when it passes the allowlist."""
    lines = [a for a in item["args"].split() if a.startswith(("--lua-desync=", "--payload=", "--out-range=", "--in-range="))]
    if not any(l.startswith("--lua-desync=") for l in lines):
        raise Fail("this finding has no desync to save")
    for l in lines:
        check_line(l, "TCP_TLS")
    test = item["test"]
    body = "\n".join(lines)
    secs = {"TCP_HTTP": "--lua-desync=fake:blob=http_iana:tcp_md5:repeats=6\n--lua-desync=multisplit:pos=2,host+1",
            "TCP_TLS": "--lua-desync=fake:blob=tls_google:tcp_md5:repeats=6\n--lua-desync=multisplit:pos=2,midsld",
            "TCP_GENERIC": "--lua-desync=fake:blob=tls_google:tcp_md5:repeats=4\n--lua-desync=multisplit:pos=2",
            "QUIC": "--lua-desync=fake:blob=quic_google:repeats=6"}
    if test == "curl_test_http":
        secs["TCP_HTTP"] = body
    elif test == "curl_test_http3":
        secs["QUIC"] = body
    else:
        secs["TCP_TLS"] = body
        secs["TCP_GENERIC"] = body
        secs["GOOGLE_TLS"] = body
    text = "# from blockcheck2: %s %s %s\n" % (test, item["ip"], item["domain"])
    text += "".join("[%s]\n%s\n" % (k, v) for k, v in secs.items())
    parse_preset(text)
    return text


def cmd_blockcheck(args):
    require_installed()
    verb = args[0] if args else "status"
    if verb == "start":
        domains, level = [], "quick"
        rest = args[1:]
        while rest:
            a = rest.pop(0)
            if a == "--level" and rest:
                level = rest.pop(0)
            else:
                domains.append(a.lower())
        domains = domains or ["youtube.com", "discord.com"]
        if level not in ("quick", "standard", "force"):
            raise Fail("level: quick, standard or force")
        bad = [d for d in domains if not RE_DOMAIN.match(d)]
        if bad or len(domains) > 8:
            raise Fail("up to 8 domains, plain names: %s" % " ".join(bad))
        if not (tool("host") or tool("nslookup")):
            raise Fail("blockcheck2 needs host or nslookup: install them with `omarchy pkg add bind`")
        # the bypass stops while blockcheck2 runs (Conflicts=); bring it back afterwards
        resume = unit_state(UNIT).get("ActiveState") == "active"
        req = {"domains": domains, "level": level, "ipv6": load_settings()["ipv6"], "resume": resume}
        atomic_write(var_path("blockcheck.json"), json.dumps(req) + "\n")
        sh("systemctl", "--no-ask-password", "reset-failed", BC_UNIT, timeout=10)
        systemctl("start", BC_UNIT)
        out({"ok": True, "started": True, "request": req})
    elif verb == "stop":
        systemctl("stop", BC_UNIT)
        out({"ok": True})
    elif verb == "status":
        text = read_nofollow(os.path.join(RUN_BC, "blockcheck.log"), 16 * 1024 * 1024) or ""
        lines = text.splitlines()
        st = unit_state(BC_UNIT)
        out({"ok": True, "active": st.get("ActiveState", "inactive"), "result": st.get("Result", ""),
             "tail": lines[-60:], "lines": len(lines), "found": parse_blockcheck(text),
             "done": "* SUMMARY" in text})
    elif verb == "save":
        if len(args) < 2 or not args[1].isdigit():
            raise Fail("usage: blockcheck save <index> [name]")
        found = parse_blockcheck(read_nofollow(os.path.join(RUN_BC, "blockcheck.log"), 16 * 1024 * 1024) or "")
        i = int(args[1])
        if i >= len(found):
            raise Fail("no such finding")
        text = strategy_from_found(found[i])
        name = custom_name(args[2] if len(args) > 2 else "bc-%d-%s" % (i + 1, found[i]["test"][10:].replace("_", "-")))
        atomic_write(var_path("custom", name + ".txt"), text)
        out({"ok": True, "name": name})
    else:
        raise Fail("usage: blockcheck start|stop|status|save")


# --------------------------------------------------------------- engine, setup, removal (user side)

def latest_release():
    data = json.loads(http_get(REPO_API, 2 * 1024 * 1024))
    tag = data.get("tag_name", "")
    if not RE_VERSION.match(tag):
        raise Fail("unexpected release tag: %r" % tag)
    want = "zapret2-%s.tar.gz" % tag
    for a in data.get("assets", []):
        if a.get("name") == want:
            digest = str(a.get("digest") or "")
            sha = digest.split(":", 1)[1] if digest.startswith("sha256:") else ""
            url = a.get("browser_download_url", "")
            if not url.startswith("https://github.com/bol-van/zapret2/releases/download/"):
                raise Fail("unexpected download location")
            return {"version": tag, "url": url, "sha256": sha, "size": a.get("size", 0)}
    raise Fail("release %s has no %s" % (tag, want))


def cmd_engine_check():
    rec = load_record()
    latest = latest_release()
    out({"ok": True, "installed": rec.get("version") if rec else None, "latest": latest["version"],
         "update": not rec or rec.get("version") != latest["version"]})


def escalate(*args):
    """Run this script as root: sudo in a terminal, pkexec (polkit prompt) otherwise."""
    py = "/usr/bin/python3"
    if sys.stdin.isatty() and tool("sudo"):
        r = subprocess.run([tool("sudo"), py, "-I", SELF] + list(args), env=child_env())
        return r.returncode, "", ""
    pk = tool("pkexec")
    if not pk:
        raise Fail("pkexec not found: run in a terminal: sudo %s %s" % (SELF, " ".join(args)))
    r = sh(pk, py, "-I", SELF, *args, timeout=900)
    return r.returncode, r.stdout, r.stderr


def escalated(what, *args):
    rc, so, se = escalate(*args)
    if rc in (126, 127) and not so.strip():
        raise Fail("%s cancelled: nothing was changed" % what)
    if rc != 0:
        msg = ""
        for line in reversed(so.strip().splitlines()):
            try:
                msg = json.loads(line).get("error", "")
                break
            except ValueError:
                continue
        raise Fail("%s failed: %s" % (what, msg or (se.strip().splitlines() or ["exit %d" % rc])[-1]))
    for line in reversed(so.strip().splitlines()):
        try:
            return json.loads(line)
        except ValueError:
            continue
    return {}


def cmd_setup(args):
    rec = load_record()
    if rec and rec.get("uid") != os.getuid():
        raise Fail("zapret2 is set up for another user on this machine")
    app_only = "--app-only" in args
    if app_only and rec:
        res = escalated("Update", "_install")
        out({"ok": True, "version": rec.get("version"), "updated": "app", "result": res})
        return
    progress(step="release")
    rel = latest_release()
    if not RE_SHA.match(rel["sha256"]):
        raise Fail("the release has no sha256 digest to verify against")
    progress(step="download", version=rel["version"])
    data = http_get(rel["url"], MAX_TARBALL, timeout=120)
    got = hashlib.sha256(data).hexdigest()
    if got != rel["sha256"]:
        raise Fail("checksum mismatch: the download is not the published release")
    d = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir(), "omarchy-zapret2")
    os.makedirs(d, mode=0o700, exist_ok=True)
    os.chmod(d, 0o700)
    tarball = os.path.join(d, "zapret2-%s.tar.gz" % rel["version"])
    atomic_write(tarball, data, mode=0o600)
    progress(step="install", version=rel["version"])
    try:
        res = escalated("Setup", "_install", "--tarball", tarball, "--sha256", got, "--version", rel["version"])
    finally:
        try:
            os.unlink(tarball)
        except OSError:
            pass
    if not os.path.exists(var_path("settings.json")):
        save_settings(dict(DEFAULTS))
    desktop(True)
    out({"ok": True, "version": rel["version"], "result": res})


def cmd_remove(args):
    rec = load_record()
    if not rec:
        desktop(False)
        out({"ok": True, "removed": False})
        return
    extra = ["--purge"] if "--purge" in args else []
    res = escalated("Removal", "_uninstall", *extra)
    desktop(False)
    out({"ok": True, "removed": True, "result": res})


def desktop(on):
    if not on:
        try:
            os.unlink(DESKTOP)
        except FileNotFoundError:
            pass
        return
    text = ("[Desktop Entry]\nType=Application\nName=Zapret2\nGenericName=DPI bypass\n"
            "Comment=zapret2 DPI bypass: strategies, lists, checks\n"
            "Exec=omarchy-shell shell toggle %s {}\nIcon=network-vpn\nTerminal=false\n"
            "Categories=Network;Utility;\nKeywords=zapret;dpi;youtube;discord;bypass;\n" % PLUGIN_ID)
    try:
        if read_nofollow(DESKTOP, MAX_SMALL) == text:
            return
    except Fail:
        pass
    atomic_write(DESKTOP, text)


def journal(n, unit=UNIT):
    r = sh("journalctl", "-u", unit, "-n", str(n), "--no-pager", "-o", "short-iso", timeout=15)
    return [l for l in r.stdout.splitlines() if l.strip() and not l.startswith("-- ")]


def cmd_logs(args):
    n = int(args[0]) if args and args[0].isdigit() else 120
    lines = journal(min(n, 2000))
    note = "" if lines else "No log lines: your user may need the wheel or systemd-journal group to read system logs"
    out({"ok": True, "lines": lines, "note": note})


def cmd_doctor():
    items = []

    def add(name, ok, detail=""):
        items.append({"name": name, "ok": bool(ok), "detail": detail})

    rec = load_record()
    add("Setup", installed(), "run setup" if not rec else ("another user" if rec.get("uid") != os.getuid() else rec.get("version", "")))
    if rec:
        bad = []
        for path, sha in rec.get("files", {}).items():
            try:
                if sha256_file(path) != sha:
                    bad.append(path)
            except PermissionError:
                pass                                   # e.g. polkit rules: root-only directory
            except OSError:
                bad.append(path)
        add("System files", not bad, "changed or missing: " + ", ".join(bad[:4]) if bad else "%d files intact" % len(rec.get("files", {})))
        own = rec.get("files", {}).get(SYS_APP + "/bin/omarchy-zapret2")
        add("Plugin and system copy", own == sha256_file(SELF), "" if own == sha256_file(SELF) else "the plugin was updated: run setup --app-only (Update system part)")
        eng = os.path.join(SYS_ENGINE, "current", "nfq2", "nfqws2")
        r = sh(eng, "--version", timeout=10)
        add("nfqws2", r.returncode == 0 and rec.get("version", "") in r.stdout, r.stdout.strip().splitlines()[0] if r.stdout.strip() else r.stderr.strip())
    add("nft", tool("nft"), "nftables" if tool("nft") else "install nftables")
    add("curl", tool("curl"), "HTTP/3 " + ("yes" if has_http3() else "no (QUIC checks skipped)") if tool("curl") else "install curl")
    add("pkexec", tool("pkexec"), "" if tool("pkexec") else "install polkit")
    dns = tool("host") or tool("nslookup")
    add("host/nslookup", dns, "for blockcheck2" if dns else "blockcheck2 needs them: omarchy pkg add bind")
    other = [u for u in ("zapret2.service", "zapret.service", "nfqws2@.service")
             if unit_state(u).get("ActiveState") == "active"]
    add("No other zapret", not other, "running: " + ", ".join(other) if other else "")
    xray = unit_state("omarchy-xray-tun.service").get("ActiveState") == "active"
    add("No VPN tunnel", not xray, "omarchy-xray TUN is on: traffic leaves through the tunnel, the bypass does not apply" if xray else "")
    if installed():
        st = unit_state(UNIT)
        add("Service", st.get("ActiveState") != "failed", "%s (%s), restarts %s" % (st.get("ActiveState"), st.get("SubState"), st.get("NRestarts", "0")))
    names = flowseal_names()
    try:
        updated = any(f.startswith("fs-") and f.endswith(".txt") for f in os.listdir(var_path("flowseal")))
    except OSError:
        updated = False
    add("Flowseal presets", bool(names), "%d presets%s" % (len(names), ", updated set" if updated else ", bundled" if names else ""))
    out({"ok": True, "items": items, "healthy": all(i["ok"] for i in items)})


# --------------------------------------------------------------- privileged half

def require_root(from_system=False):
    if os.geteuid() != 0:
        raise Fail("this command is for the system services")
    if from_system and not SELF.startswith(SYS_APP + "/"):
        raise Fail("refusing to run outside %s" % SYS_APP)


def caller_uid():
    for k in ("PKEXEC_UID", "SUDO_UID"):
        v = os.environ.get(k, "")
        if v.isdigit() and int(v) >= 1000:
            return int(v)
    raise Fail("run through pkexec or sudo from your user account")


