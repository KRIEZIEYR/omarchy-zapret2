QNUM = 220
MARK = 0x40000000

REPO_API = "https://api.github.com/repos/bol-van/zapret2/releases/latest"
UPSTREAM = "https://raw.githubusercontent.com/Flowseal/zapret-discord-youtube/main/"
# lists/ipset-all.txt upstream is a placeholder that service.bat swaps; the real set lives in .service/
UPSTREAM_LISTS = {"list-general": "lists/list-general.txt", "list-google": "lists/list-google.txt",
                  "list-exclude": "lists/list-exclude.txt", "ipset-exclude": "lists/ipset-exclude.txt",
                  "ipset-all": ".service/ipset-service.txt"}
DESKTOP = os.path.expanduser("~/.local/share/applications/omarchy-zapret2.desktop")
